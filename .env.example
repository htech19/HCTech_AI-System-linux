# =============================================================================
# HC TECH AI SYSTEM — Exemplo de configuração
# Copie para backend/.env e ajuste os valores
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="HC Tech AI System"
APP_ENV=development
DEBUG=true
SECRET_KEY=GERE_COM: python -c "import secrets; print(secrets.token_hex(32))"

# ─── Servidor ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Linux: caminho relativo ao diretório backend/
DATABASE_URL=sqlite+aiosqlite:///./data/hctech.db

# ─── IA — Ollama (local, grátis) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# ─── IA — OpenAI (opcional, pago) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ─── IA — Anthropic (opcional, pago) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

# ─── Configuração dos agentes ────────────────────────────────────────────────
AI_PROVIDER=ollama
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_TIMEOUT=120

# ─── Negócio ──────────────────────────────────────────────────────────────────
BUSINESS_NAME="HC Tech InfoCell"
BUSINESS_CITY="São Bernardo do Campo"
BUSINESS_STATE=SP
BUSINESS_REGION="Grande ABC"
BUSINESS_SINCE=2011
BUSINESS_WEBSITE=https://www.hctechinfocell.com.br
BUSINESS_SPECIALTIES="smartphones,notebooks,tablets"

# ─── APScheduler ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/hctech.log